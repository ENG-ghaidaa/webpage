-- Create Database
CREATE DATABASE IF NOT EXISTS person_database;

-- Use Database
USE person_database;

-- Create People Table
CREATE TABLE IF NOT EXISTS people (
    id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    age INT NOT NULL,
    status TINYINT DEFAULT 0
);

